#!/bin/bash
# Erstinstallation des Servers (laeuft einmalig beim ersten Start).
set -euxo pipefail

# --- Pakete und automatische Sicherheitsupdates ---------------------------------
dnf -y upgrade --security
dnf -y install docker dnf-automatic
sed -i 's/^upgrade_type = .*/upgrade_type = security/; s/^apply_updates = .*/apply_updates = yes/' /etc/dnf/automatic.conf
systemctl enable --now dnf-automatic.timer

# Docker Compose v2 (nicht in den AL2023-Paketquellen), mit Pruefsumme.
COMPOSE_VERSION=v2.39.2
COMPOSE_SHA256=54488fffb60782f3c8787a48b95ed15f49f5a3a85f4105304bd46db5edd9db61
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose \
  "https://github.com/docker/compose/releases/download/$${COMPOSE_VERSION}/docker-compose-linux-aarch64"
echo "$${COMPOSE_SHA256}  /usr/local/lib/docker/cli-plugins/docker-compose" | sha256sum -c -
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# Container-Logs begrenzen, damit die Disk nicht volllaeuft.
mkdir -p /etc/docker
cat > /etc/docker/daemon.json <<'JSON'
{
  "log-driver": "local",
  "log-opts": { "max-size": "10m", "max-file": "5" },
  "live-restore": true
}
JSON
systemctl enable --now docker

# --- Swap: 2 GB Puffer fuer den 2-GB-Server ---------------------------------------
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  echo '/swapfile none swap defaults 0 0' >> /etc/fstab
fi
swapon -a

# --- Datenvolume einhaengen ----------------------------------------------------------
# Das Volume wird ueber seine ID gefunden (der Geraetename ist bei Nitro-Servern
# nicht stabil). Formatiert wird nur, wenn noch kein Dateisystem existiert:
# Ein vorhandenes Volume mit Daten wird niemals ueberschrieben.
VOLUME_SERIAL="$(echo '${data_volume_id}' | tr -d '-')"
DEVICE="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$${VOLUME_SERIAL}"
for _ in $(seq 1 60); do
  [ -e "$DEVICE" ] && break
  sleep 5
done
[ -e "$DEVICE" ] || { echo "Datenvolume $DEVICE nicht gefunden" >&2; exit 1; }

if ! blkid "$DEVICE" >/dev/null 2>&1; then
  mkfs.xfs -L vereint-data "$DEVICE"
fi

mkdir -p /srv/vereint
if ! grep -q 'LABEL=vereint-data' /etc/fstab; then
  echo 'LABEL=vereint-data /srv/vereint xfs defaults,nofail 0 2' >> /etc/fstab
fi
mount -a
mkdir -p /srv/vereint/data /srv/vereint/app
