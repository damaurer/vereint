# Oeffentlicher Einstiegspunkt. Caddy holt und erneuert das TLS-Zertifikat
# fuer die Domain automatisch bei Let's Encrypt; HTTP leitet auf HTTPS um.
{$PUBLIC_DOMAIN} {
	encode zstd gzip

	# Groesster legitimer Request ist ein Bild-Upload (6 MB, siehe baseservice).
	# Einzige Ausnahme: Bilder und kurze Videos in Moments (bis 100 MiB, siehe
	# MomentMediaService); sie stroemen ungepuffert bis in den Objektspeicher.
	@momentMedia path_regexp momentMedia ^/api/v1/events/[^/]+/moments/[^/]+/media$
	@otherRequests not path_regexp ^/api/v1/events/[^/]+/moments/[^/]+/media$
	request_body @momentMedia {
		max_size 110MB
	}
	request_body @otherRequests {
		max_size 8MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Browser-Funktionen, die die App nicht braucht, sind abgeschaltet.
		# Die Kamera bleibt fuer den Barcode-Scan, der Standort fuer die freiwillige
		# Standortfreigabe in Moments auf der eigenen Seite erlaubt.
		Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=(), usb=(), display-capture=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}

	# Keycloak-Verwaltung (Admin-Konsole und Master-Realm) ist von aussen
	# nicht erreichbar, nur per Session-Manager-Tunnel (siehe README).
	handle /kc/admin* {
		respond 404
	}
	handle /kc/realms/master* {
		respond 404
	}
	# Dynamische Client-Registrierung wird nicht genutzt.
	@clientRegistration path_regexp ^/kc/realms/[^/]+/clients-registrations(/|$)
	handle @clientRegistration {
		respond 404
	}

	# Stripe-Webhooks gehen direkt an den Fachservice, der die Signatur prueft.
	handle /api/v1/billing/stripe/webhook {
		reverse_proxy baseservice:8081
	}

	handle /kc/* {
		reverse_proxy keycloak:8080
	}

	handle {
		reverse_proxy webservice:8080
	}

	log {
		output stdout
		format json
	}
}

# Statische Website (Ordner website/ im Repository, siehe docs/website.md).
# WEBSITE_DOMAIN kann mehrere Namen enthalten, z. B. "example.de, www.example.de".
# Ist sie nicht gesetzt, setzt compose.yaml einen Namen ein, den niemand
# aufruft (http://website.invalid); dann holt Caddy dafuer kein Zertifikat.
{$WEBSITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Nur eigene Dateien, keine Inline-Skripte, keine fremden Dienste.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Links der Website in die App: /app/<pfad> fuehrt auf https://<App-Domain>/<pfad>.
	redir /app /app/ 308
	handle_path /app/* {
		redir https://{$PUBLIC_DOMAIN}{uri} 302
	}

	handle {
		root * /srv/website
		@assets path /assets/* /bilder/*
		header @assets Cache-Control "public, max-age=86400"
		file_server
	}

	handle_errors 404 {
		rewrite * /404.html
		root * /srv/website
		file_server
	}

	log {
		output stdout
		format json
	}
}
