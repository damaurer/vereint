# VEREINT Umgebungsvariablen für die lokale Entwicklung
#
# Einmal kopieren, danach läuft alles ohne weitere Änderungen:
#
#   cp .env.example .env            (oder `npm run env:prepare` im webservice/)
#   docker compose up -d            Keycloak und beide PostgreSQL
#   cd baseservice && ./gradlew bootRun     Fachservice, Port 8081
#   cd webservice && npm start               Oberfläche mit SSR und BFF, Port 4200
#
# App: http://localhost:4200, Anmeldung mit `admin`, `board` oder `member`
# (Passwörter unten bei KEYCLOAK_SEED_*; Keycloak verlangt beim ersten Login
# ein neues Passwort). `docker compose`, `./gradlew bootRun` und der webservice
# lesen alle diese eine `.env` im Repo-Wurzelverzeichnis.
#
# Alle Passwörter und Secrets hier sind bekannte Entwicklungswerte. Sie gelten
# nur für die lokalen Container auf diesem Rechner, die ausschließlich auf
# localhost lauschen. Produktion braucht eigene Werte
# (docs/betrieb/selbst-betreiben.md); diese Datei wird dort nie benutzt.
# Den kompletten Stack inklusive Demo-Daten startet auch `node local/vereint.mjs up`
# (siehe local/README.md); der braucht diese Datei nicht.

# --- Laufzeit Angular/Express ------------------------------------------------
NODE_ENV=development
# Port des SSR-/Express-Servers, wenn er als Build läuft
# (`node dist/webservice/server/server.mjs`); `npm start` nutzt ebenfalls 4200.
PORT=4200
# Adresse, unter der der Browser die App aufruft. Der Entwicklungsrealm
# (keycloak/dev) leitet nach dem Login nur hierhin zurück.
PUBLIC_BASE_URL=http://localhost:4200
# Fachservice (baseservice), an den das BFF die API-Aufrufe weiterreicht.
SPRING_API_BASE_URL=http://localhost:8081

# --- Session -----------------------------------------------------------------
SESSION_COOKIE_NAME=vereint_session
# Lokal ohne TLS `false`; in jeder deployten Umgebung `true`.
SESSION_COOKIE_SECURE=false
SESSION_DURATION_MINUTES=1440
# Signaturschlüssel der Express-Session, mindestens 32 Byte. Nur lokal gültig.
SESSION_SECRET=local-dev-session-secret-not-for-production
# Vorgängerschlüssel für die Rotation; lokal nicht nötig.
SESSION_SECRET_PREVIOUS=

# --- Keycloak ----------------------------------------------------------------
# Keycloak aus docker-compose.yml (Port 8082) mit dem Entwicklungsrealm.
KEYCLOAK_ISSUER_URI=http://localhost:8082/realms/vereint
KEYCLOAK_JWK_SET_URI=http://localhost:8082/realms/vereint/protocol/openid-connect/certs
KEYCLOAK_REALM=vereint
KEYCLOAK_CLIENT_ID=vereint-web
# Client-Secrets setzt der Realm-Import beim ersten Keycloak-Start aus diesen
# Werten; BFF und Fachservice nutzen dieselben Werte.
KEYCLOAK_CLIENT_SECRET=local-dev-web-client-secret
# Vertraulicher Client der Tablet-Erfassung (technische Identität).
KEYCLOAK_TABLET_CLIENT_SECRET=local-dev-tablet-client-secret
# Vertraulicher Client, mit dem der Fachservice neue Mitgliedskonten per
# Einladungslink anlegt (nur realm-management/manage-users).
KEYCLOAK_REGISTRATION_CLIENT_SECRET=local-dev-registration-client-secret
REGISTRATION_ENABLED=true
# Admin-API für die Kontoanlage per Einladungslink.
KEYCLOAK_ADMIN_BASE_URL=http://localhost:8082
# Zeitlimit der Keycloak-Aufrufe aus Express in Millisekunden.
KEYCLOAK_REQUEST_TIMEOUT_MS=3000
# Anzahl der automatischen Wiederholungsversuche bei Keycloak-Anfragen.
KEYCLOAK_REQUEST_RETRIES=1
# Keycloak-Admin-Konsole: http://localhost:8082/admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-keycloak-admin
# Startpasswörter der Konten admin, board und member im Entwicklungsrealm.
# Keycloak verlangt beim ersten Login ein neues Passwort (mindestens 10 Zeichen).
KEYCLOAK_SEED_ADMIN_PASSWORD=admin-demo-2026
KEYCLOAK_SEED_BOARD_PASSWORD=board-demo-2026
KEYCLOAK_SEED_MEMBER_PASSWORD=member-demo-2026

# --- Gruppen und Registrierung ----------------------------------------------
# Keycloak-Testkonten ohne Mitgliedschaft treten automatisch „Meine Gruppe"
# bei (Realmrollen werden Gruppenrollen). In Produktion nie setzen.
TENANCY_BOOTSTRAP_REALM_ROLES=true
# Selbst eröffnete Gruppen (/gruppe-eroeffnen) an; höchstens 3 eigene je Person.
# Ohne diese Zeile ist das Eröffnen aus (Standard des baseservice).
SIGNUP_ENABLED=true
SIGNUP_MAX_OWNED=3

# --- PostgreSQL für Keycloak --------------------------------------------------
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=local-dev-keycloak-db
KEYCLOAK_DB_PORT=5433
KEYCLOAK_DB_URL=jdbc:postgresql://localhost:5433/keycloak

# --- PostgreSQL für vereint ----------------------------------------------------
VEREINT_DB_NAME=vereint
VEREINT_DB_USERNAME=vereint
VEREINT_DB_PASSWORD=local-dev-vereint-db
VEREINT_DB_PORT=5432
VEREINT_DB_URL=jdbc:postgresql://localhost:5432/vereint

# --- Dateispeicher ---------------------------------------------------------------
# Bilder und Videos landen wie in Produktion in einem Verzeichnis
# (relativ zu baseservice/, also <Repo>/.data/files; nicht versioniert).
# STORAGE_BACKEND=memory hält sie nur im Arbeitsspeicher des Fachservice.
STORAGE_BACKEND=filesystem
STORAGE_DIRECTORY=../.data/files

# --- Verschlüsselung -----------------------------------------------------------
# Lokal aus, damit man Chat und Mitteilungen direkt in der Datenbank lesen kann.
# In Produktion an (AES-256-GCM, Schlüssel vom Betreiber). Mit dem Kontext
# `prod` startet der baseservice ohne Verschlüsselung nicht; lokal genügt
# EV_LIQUIBASE_CONTEXTS=dev (unten).
DATA_ENCRYPTION_ENABLED=false

# --- Web Push (VAPID) ---------------------------------------------------------
# Lokal aus. Zum Testen ein Schlüsselpaar erzeugen
# (`npx web-push generate-vapid-keys`) und VAPID_ENABLED=true setzen.
VAPID_SUBJECT=mailto:dev@example.invalid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ENABLED=false
VAPID_TTL_SECONDS=2419200

# --- Spring Boot ---------------------------------------------------------
VEREIN_CORS_ALLOWED_ORIGINS=http://localhost:4200
EV_LIQUIBASE_ENABLED=true
# `dev` gilt nicht als Produktion: Klartext und der Superuser `vereint` aus
# docker-compose.yml lösen nur Warnungen aus. Mit `prod` bricht der Start ab.
EV_LIQUIBASE_CONTEXTS=dev
# Swagger UI unter http://localhost:8081/swagger-ui.html; in Produktion aus.
API_DOCS_ENABLED=true
