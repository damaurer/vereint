# VEREINT Umgebungsvariablen
#
# Vorlage für die lokale Entwicklung mit `docker compose` (Keycloak, beide
# PostgreSQL-Instanzen, MinIO, Spring-Boot-Fachservice, Angular/Express).
# `npm run env:prepare` kopiert diese Datei nach `.env`, falls dort noch keine
# existiert. `docker compose` liest dieselbe `.env`.
#
# Diese Datei enthält ausschließlich Platzhalter. Reale Secrets für Keycloak,
# PostgreSQL, S3 und Web Push gehören niemals in dieses Repository, in ein
# Browser-Bundle oder in SSR-HTML (siehe AGENTS.md und docs/deployment.md).
# Ersetze jeden `change-me-*`-Wert vor dem ersten Start durch einen lokal
# erzeugten Zufallswert.

# --- Laufzeit Angular/Express ------------------------------------------------
NODE_ENV=development
# Port des SSR-/Express-Servers.
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
SPRING_API_BASE_URL=http://localhost:8081

# --- Session -----------------------------------------------------------------
SESSION_COOKIE_NAME=vereint_session
# Lokal ohne TLS `false`; in jeder deployten Umgebung `true`.
SESSION_COOKIE_SECURE=false
SESSION_DURATION_MINUTES=1440
# Signaturschlüssel der Express-Session: mindestens 32 Byte, lokal erzeugen,
# nie versionieren (`node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`).
SESSION_SECRET=change-me-session-secret-min-32-bytes-long
# Vorgängerschlüssel für die Rotation: bestehende Cookies bleiben lesbar,
# solange dieser Wert gesetzt ist. Muss sich von `SESSION_SECRET` unterscheiden.
SESSION_SECRET_PREVIOUS=

# --- Keycloak ----------------------------------------------------------------
KEYCLOAK_ISSUER_URI=http://localhost:8082/realms/vereint
KEYCLOAK_JWK_SET_URI=http://localhost:8082/realms/vereint/protocol/openid-connect/certs
KEYCLOAK_REALM=vereint
KEYCLOAK_CLIENT_ID=vereint-web
KEYCLOAK_CLIENT_SECRET=change-me-keycloak-client-secret
# Vertraulicher Client der Tablet-Erfassung (technische Identität).
KEYCLOAK_TABLET_CLIENT_SECRET=change-me-keycloak-tablet-client-secret
# Vertraulicher Client, mit dem der Fachservice neue Mitgliedskonten per
# Einladungslink anlegt (nur realm-management/manage-users).
KEYCLOAK_REGISTRATION_CLIENT_SECRET=change-me-keycloak-registration-client-secret
REGISTRATION_ENABLED=true
# Mehrere Stammtische: Keycloak-Testkonten ohne Mitgliedschaft treten lokal
# automatisch „Meine Gruppe" bei (Realmrollen werden Stammtischrollen).
# In Produktion nie setzen; dort kommt man nur per Einladungslink hinein.
TENANCY_BOOTSTRAP_REALM_ROLES=true
# Tarife je Stammtisch über Stripe (siehe docs/domains/abrechnung.md). Ohne
# Werte ist die Online-Zahlung aus; Tarife setzt dann die Plattform-Administration.
# Lokal nur Test-Schlüssel (sk_test_...) verwenden.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STAMMTISCH_MONTH=
STRIPE_PRICE_STAMMTISCH_YEAR=
STRIPE_PRICE_VEREIN_MONTH=
STRIPE_PRICE_VEREIN_YEAR=
STRIPE_PRICE_SUPPORTER=
KEYCLOAK_ADMIN_BASE_URL=http://localhost:8082
# Zeitlimit der Keycloak-Aufrufe aus Express in Millisekunden.
KEYCLOAK_REQUEST_TIMEOUT_MS=3000
# Anzahl der automatischen Wiederholungsversuche bei Keycloak-Anfragen.
KEYCLOAK_REQUEST_RETRIES=1
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password
# Startpasswörter der Entwicklungs-Seed-Benutzer aus `keycloak/dev`.
# Sie existieren ausschließlich lokal und niemals in einer deployten Umgebung.
KEYCLOAK_SEED_ADMIN_PASSWORD=change-me-seed-admin-password
KEYCLOAK_SEED_BOARD_PASSWORD=change-me-seed-board-password
KEYCLOAK_SEED_MEMBER_PASSWORD=change-me-seed-member-password

# --- PostgreSQL für Keycloak --------------------------------------------------
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db-password
KEYCLOAK_DB_PORT=5433
KEYCLOAK_DB_URL=jdbc:postgresql://localhost:5433/keycloak

# --- PostgreSQL für vereint ----------------------------------------------------
VEREINT_DB_NAME=vereint
VEREINT_DB_USERNAME=vereint
VEREINT_DB_PASSWORD=change-me-vereint-db-password
VEREINT_DB_PORT=5432
VEREINT_DB_URL=jdbc:postgresql://localhost:5432/vereint

# --- S3-kompatibler Objektspeicher (MinIO) ------------------------------------
S3_ENABLED=false
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=vereint
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me-s3-access-key
S3_SECRET_KEY=change-me-s3-secret-key
S3_PATH_STYLE_ACCESS=true
S3_URL_TTL_SECONDS=900

# --- Web Push (VAPID) ---------------------------------------------------------
# Schlüsselpaar lokal erzeugen; der private Schlüssel bleibt serverseitig.
VAPID_SUBJECT=mailto:dev@example.invalid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ENABLED=false
VAPID_TTL_SECONDS=2419200

# --- Spring Boot ---------------------------------------------------------
VEREIN_CORS_ALLOWED_ORIGINS=http://localhost:4200
EV_LIQUIBASE_ENABLED=true
EV_LIQUIBASE_CONTEXTS=dev