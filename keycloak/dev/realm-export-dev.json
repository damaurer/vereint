        "treasurer",
        "member"
      ]
    },
    {
      "id": "e0000000-0000-0000-0000-000000000003",
      "username": "member",
      "email": "member@vereint.local",
      "firstName": "Mitglied",
      "lastName": "VEREINT",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_SEED_MEMBER_PASSWORD}",
          "temporary": true
        }
      ],
      "realmRoles": [
        "member"
      ]
    }
  ]
}
