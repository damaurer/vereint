<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <property name="uuid.type" value="UUID" dbms="postgresql"/>
    <property name="uuid.type" value="UUID" dbms="h2"/>

    <preConditions>
        <or>
            <dbms type="postgresql"/>
            <dbms type="h2"/>
        </or>
    </preConditions>

    <!-- 140. Kiosk-PIN des Thekenterminals. Genau eine Zeile (`id = 'default'`);
         gespeichert wird nur der BCrypt-Hash der PIN. Fehlversuche und Sperre
         liegen hier, damit sie auf allen Terminals und über Neustarts gelten. -->
    <changeSet id="140-create-kiosk-settings" author="claude">
        <createTable tableName="kiosk_settings">
            <column name="id" type="VARCHAR(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pin_hash" type="VARCHAR(100)"/>
            <column name="failed_attempts" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="lockout_count" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="locked_until" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="pin_updated_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="pin_updated_by" type="${uuid.type}">
                <constraints foreignKeyName="fk_kiosk_settings_updater" references="users(id)"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE kiosk_settings
            ADD CONSTRAINT ck_kiosk_settings_counters
            CHECK (failed_attempts >= 0 AND lockout_count >= 0)
        </sql>
        <rollback>
            <dropTable tableName="kiosk_settings"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
