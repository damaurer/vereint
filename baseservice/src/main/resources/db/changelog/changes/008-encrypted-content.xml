<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <property name="text.type" value="TEXT" dbms="postgresql"/>
    <property name="text.type" value="VARCHAR(65535)" dbms="h2"/>

    <preConditions>
        <or>
            <dbms type="postgresql"/>
            <dbms type="h2"/>
        </or>
    </preConditions>

    <!-- 113. Benachrichtigungstitel werden verschlüsselt gespeichert; der
         Base64-Chiffretext ist länger als 255 Zeichen. -->
    <changeSet id="113-notification-title-text" author="claude">
        <modifyDataType tableName="notifications" columnName="title" newDataType="${text.type}"/>
        <rollback>
            <modifyDataType tableName="notifications" columnName="title" newDataType="VARCHAR(255)"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
