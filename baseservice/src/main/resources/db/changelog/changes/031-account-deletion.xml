<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <preConditions>
        <or>
            <dbms type="postgresql"/>
            <dbms type="h2"/>
        </or>
    </preConditions>

    <!-- 350. Selbst gelöschte Konten (#152). Die Zeile in `users` bleibt als
         Platzhalter „Gelöschtes Konto“ bestehen, damit Buchungen, Runden, Events
         und das Audit-Protokoll der Gruppen gültig bleiben. Name und E-Mail sind
         dann geleert; `deleted_at` hält fest, wann gelöscht wurde. -->
    <changeSet id="350-add-users-deleted-at" author="claude">
        <addColumn tableName="users">
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
