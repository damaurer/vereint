        </rollback>
    </changeSet>

    <!-- 152. Ein Beitrag darf auch nur Text, Bilder oder Videos enthalten. -->
    <changeSet id="152-moment-response-reaction-optional" author="claude">
        <dropNotNullConstraint tableName="moment_responses" columnName="reaction" columnDataType="VARCHAR(64)"/>
        <rollback>
            <addNotNullConstraint tableName="moment_responses" columnName="reaction" columnDataType="VARCHAR(64)" defaultNullValue=""/>
        </rollback>
    </changeSet>

    <!-- 153. Bilder und kurze Videos in Moments. Die Dateien liegen verschlüsselt
         im Objektspeicher; hier stehen nur Metadaten. `response_id` ist leer,
         solange der Upload noch zu keinem abgesendeten Beitrag gehört. -->
    <changeSet id="153-create-moment-media" author="claude">
        <createTable tableName="moment_media">
            <column name="id" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="moment_id" type="${uuid.type}">
                <constraints nullable="false" foreignKeyName="fk_moment_media_moment" references="moment_sessions(id)" deleteCascade="true"/>
            </column>
            <column name="response_id" type="${uuid.type}">
                <constraints foreignKeyName="fk_moment_media_response" references="moment_responses(id)" deleteCascade="true"/>
            </column>
            <column name="owner_id" type="${uuid.type}">
                <constraints nullable="false" foreignKeyName="fk_moment_media_owner" references="users(id)" deleteCascade="true"/>
            </column>
            <column name="kind" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="content_type" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="size_bytes" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="storage_key" type="VARCHAR(512)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_moment_media_storage_key"/>
            </column>
            <column name="encrypted" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="width" type="INTEGER"/>
            <column name="height" type="INTEGER"/>
            <column name="duration_ms" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE moment_media
            ADD CONSTRAINT ck_moment_media_kind
            CHECK (kind IN ('image', 'video') AND size_bytes > 0)
        </sql>
        <createIndex tableName="moment_media" indexName="ix_moment_media_response">
            <column name="response_id"/>
        </createIndex>
        <createIndex tableName="moment_media" indexName="ix_moment_media_moment_owner">
            <column name="moment_id"/>
            <column name="owner_id"/>
        </createIndex>
        <rollback>
            <dropTable tableName="moment_media"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
