<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <property name="uuid.type" value="UUID" dbms="postgresql"/>
    <property name="uuid.type" value="UUID" dbms="h2"/>

    <preConditions>
        <or>
            <dbms type="postgresql"/>
            <dbms type="h2"/>
        </or>
    </preConditions>

    <!-- 150. Moment-Typen und Reaktionen pflegt der Vorstand. Der `code` steht in
         moment_sessions.topic_type bzw. moment_responses.reaction und ändert sich
         nie; Name und Emoji schon. Ausgemusterte Einträge (`active = false`)
         bleiben für bestehende Moments erhalten. Ein Typ erlaubt entweder alle
         aktiven Reaktionen (`all_reactions`) oder die in moment_type_reactions. -->
    <changeSet id="150-create-moment-types-and-reactions" author="claude">
        <createTable tableName="moment_reactions">
            <column name="id" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_moment_reactions_code"/>
            </column>
            <column name="name" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="emoji" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="moment_types">
            <column name="id" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_moment_types_code"/>
            </column>
            <column name="name" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="emoji" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="sort_order" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="all_reactions" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="moment_type_reactions">
            <column name="type_id" type="${uuid.type}">
                <constraints nullable="false" foreignKeyName="fk_moment_type_reactions_type" references="moment_types(id)" deleteCascade="true"/>
            </column>
            <column name="reaction_id" type="${uuid.type}">
                <constraints nullable="false" foreignKeyName="fk_moment_type_reactions_reaction" references="moment_reactions(id)" deleteCascade="true"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="moment_type_reactions" columnNames="type_id, reaction_id" constraintName="pk_moment_type_reactions"/>
        <rollback>
            <dropTable tableName="moment_type_reactions"/>
            <dropTable tableName="moment_types"/>
            <dropTable tableName="moment_reactions"/>
        </rollback>
    </changeSet>

    <!-- 151. Startbestand: die bisher fest eingebauten Typen und Reaktionen. -->
