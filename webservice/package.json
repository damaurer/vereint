{
  "name": "webservice",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prestart": "npm run env:prepare",
    "env:prepare": "node -e \"const fs=require('node:fs'),path=require('node:path');const root=fs.existsSync('.env.example')?'.':fs.existsSync('../.env.example')?'..':'.';const src=path.join(root,'.env.example');const dest=path.join(root,'.env');if(!fs.existsSync(dest)&&!fs.existsSync('.env')){fs.copyFileSync(src,dest);console.log('Created '+dest+' from '+src);}else{console.log('.env already exists.');}\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:webservice": "node dist/webservice/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.5.2",
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/ssr": "^22.2.5",
    "@openng/optimus-ui": "^2.0.2",
    "@openng/optimus-ui-themes": "^2.0.2",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "compression": "^1.8.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.19.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
